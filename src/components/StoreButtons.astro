---
import { apps } from "../data/apps";
import { type AppSlug, dictionaries, type Language } from "../i18n";

type Props = { app: AppSlug; language: Language };

const { app, language } = Astro.props;
const { appStoreUrl, playStoreUrl, name } = apps[app];
const { stores } = dictionaries[language];
---

<div class="stores">
  <a class="store" href={appStoreUrl} target="_blank" rel="noopener" aria-label={`${name}, App Store`}>
    <svg viewBox="0 0 24 24" aria-hidden="true"
      ><path
        fill="currentColor"
        d="M16.4 12.6c0-2.5 2-3.7 2.1-3.8-1.2-1.7-3-1.9-3.6-2-1.5-.2-3 .9-3.7.9-.8 0-2-.9-3.2-.9-1.7 0-3.2 1-4.1 2.4-1.8 3-.5 7.5 1.2 10 .8 1.2 1.8 2.6 3.1 2.5 1.2 0 1.7-.8 3.2-.8s1.9.8 3.2.8c1.3 0 2.2-1.2 3-2.4.9-1.4 1.3-2.7 1.3-2.8-.1 0-2.5-1-2.5-3.9zM14 5.2c.7-.8 1.1-1.9 1-3-1 0-2.1.7-2.8 1.5-.6.7-1.2 1.8-1 2.9 1.1.1 2.1-.6 2.8-1.4z"
      ></path></svg
    >
    <span><small>{stores.appStoreSmall}</small><strong>App Store</strong></span>
  </a>
  <a class="store" href={playStoreUrl} target="_blank" rel="noopener" aria-label={`${name}, Google Play`}>
    <svg viewBox="0 0 24 24" aria-hidden="true"
      ><path
        fill="currentColor"
        d="M3.6 2.3c-.3.3-.4.7-.4 1.2v17c0 .5.1.9.4 1.2l9.6-9.7-9.6-9.7zm10.6 10.7 2.7 2.7-11.6 6.6c-.3.2-.7.2-1 .1l9.9-9.4zm0-2L4.3 1.6c.3-.1.7-.1 1 .1l11.6 6.6-2.7 2.7zm3.8.1 3 1.7c.8.5.8 1.3 0 1.8l-3 1.7-3-3 3-2.2z"
      ></path></svg
    >
    <span><small>{stores.playSmall}</small><strong>Google Play</strong></span>
  </a>
</div>
