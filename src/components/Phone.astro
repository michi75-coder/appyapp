---
import { Image } from "astro:assets";
import type { ImageMetadata } from "astro";

type Props = {
  screens: { key: string; image: ImageMetadata; alt: string }[];
  class?: string;
  isEager?: boolean;
};

const { screens, class: className, isEager = false } = Astro.props;
---

<div class:list={["phone", className]}>
  <div class="phone-screen">
    {
      screens.map((screen, screenIndex) => (
        <Image
          src={screen.image}
          alt={screen.alt}
          widths={[320, 640]}
          sizes="(max-width: 760px) 60vw, 320px"
          data-screen={screen.key}
          class:list={{ "is-shown": screenIndex === 0 }}
          loading={isEager && screenIndex === 0 ? "eager" : "lazy"}
        />
      ))
    }
  </div>
</div>
